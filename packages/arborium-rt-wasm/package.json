{
	"name": "@discord/arborium-rt-wasm",
	"version": "0.1.9",
	"description": "Dynamically-linked tree-sitter + arborium runtime for the browser",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/appellation/arborium-rt.git"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./host-module": "./dist/host/web-tree-sitter.mjs",
		"./host-wasm": "./dist/host/web-tree-sitter.wasm",
		"./runtime-wasm": "./dist/runtime/arborium_emscripten_runtime.wasm"
	},
	"imports": {
		"#wasm-loader": {
			"types": "./dist/wasm-loader.d.ts",
			"browser": "./dist/wasm-loader.browser.js",
			"default": "./dist/wasm-loader.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"pretest": "../../scripts/arborium-rt package wasm grammars json && tsc && ../../scripts/arborium-rt package wasm host",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/emscripten": "^1.41.6",
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=22"
	}
}
