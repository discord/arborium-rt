 static void ts_lexer__advance(TSLexer *_self, bool skip) {
   Lexer *self = (Lexer *)_self;
   if (!self->chunk) return;
+  if (self->advance_count < UINT32_MAX) self->advance_count++;
 
   if (skip) {
     LOG("skip", self->data.lookahead)
diff --git a/crates/arborium-tree-sitter/src/lexer.h b/crates/arborium-tree-sitter/src/lexer.h
