diff --git a/crates/arborium-tree-sitter/src/parser.c b/crates/arborium-tree-sitter/src/parser.c
index bb24791..26d3667 100644
--- a/crates/arborium-tree-sitter/src/parser.c
+++ b/crates/arborium-tree-sitter/src/parser.c
@@ -111,8 +111,19 @@ struct TSParser {
   bool has_scanner_error;
   bool canceled_balancing;
   bool has_error;
+  // Children of the nodes this parse has built, each of which
+  // ts_subtree_summarize_children walks. Saturating. Published on
+  // `TSParseState` as `summarized_child_count`.
+  uint32_t summarized_child_count;
 };
 
+// Charge building a node from `child_count` children: the node constructors
+// summarize every child, so this is the work they do.
+static inline void ts_parser__count_summarized(TSParser *self, uint32_t child_count) {
+  uint32_t total = self->summarized_child_count + child_count;
+  self->summarized_child_count = total < child_count ? UINT32_MAX : total;
+}
+
 typedef struct {
   unsigned cost;
   unsigned node_count;
@@ -891,6 +902,7 @@ static bool ts_parser__select_children(
   // not perform any allocation except for possibly growing the array to make
   // room for its own heap data. The scratch tree is never explicitly released,
   // so the same 'scratch trees' array can be reused again later.
+  ts_parser__count_summarized(self, self->scratch_trees.size);
   MutableSubtree scratch_tree = ts_subtree_new_node(
     ts_subtree_symbol(left),
     &self->scratch_trees,
@@ -950,6 +962,7 @@ static StackVersion ts_parser__reduce(
   uint32_t halted_version_count = ts_stack_halted_version_count(self->stack);
   for (uint32_t i = 0; i < pop.size; i++) {
     StackSlice slice = *array_get(&pop, i);
+    self->parse_state.popped_subtree_count += slice.subtrees.size;
     StackVersion slice_version = slice.version - removed_version_count;
 
     // This is where new versions are added to the parse stack. The versions
@@ -976,6 +989,7 @@ static StackVersion ts_parser__reduce(
     SubtreeArray children = slice.subtrees;
     ts_subtree_array_remove_trailing_extras(&children, &self->trailing_extras);
 
+    ts_parser__count_summarized(self, children.size);
     MutableSubtree parent = ts_subtree_new_node(
       symbol, &children, production_id, self->language
     );
@@ -1000,6 +1014,7 @@ static StackVersion ts_parser__reduce(
         ts_subtree_array_clear(&self->tree_pool, &self->trailing_extras);
         ts_subtree_release(&self->tree_pool, ts_subtree_from_mut(parent));
         array_swap(&self->trailing_extras, &self->trailing_extras2);
+        ts_parser__count_summarized(self, next_slice_children.size);
         parent = ts_subtree_new_node(
           symbol, &next_slice_children, production_id, self->language
         );
@@ -1068,6 +1083,7 @@ static void ts_parser__accept(
           ts_subtree_retain(children[k]);
         }
         array_splice(&trees, j, 1, child_count, children);
+        ts_parser__count_summarized(self, trees.size);
         root = ts_subtree_from_mut(ts_subtree_new_node(
           ts_subtree_symbol(tree),
           &trees,
@@ -1133,6 +1149,7 @@ static bool ts_parser__do_all_potential_reductions(
       end_symbol = self->language->token_count;
     }
 
+    self->parse_state.reduction_scan_count += end_symbol - first_symbol;
     for (TSSymbol symbol = first_symbol; symbol < end_symbol; symbol++) {
       TableEntry entry;
       ts_language_table_entry(self->language, state, symbol, &entry);
@@ -1230,6 +1247,7 @@ static bool ts_parser__recover_to_state(
     ts_subtree_array_remove_trailing_extras(&slice.subtrees, &self->trailing_extras);
 
     if (slice.subtrees.size > 0) {
+      ts_parser__count_summarized(self, slice.subtrees.size);
       Subtree error = ts_subtree_new_error_node(&slice.subtrees, true, self->language);
       ts_stack_push(self->stack, slice.version, error, false, goal_state);
     } else {
@@ -1381,6 +1399,7 @@ static void ts_parser__recover(
   SubtreeArray children = array_new();
   array_reserve(&children, 1);
   array_push(&children, lookahead);
+  ts_parser__count_summarized(self, children.size);
   MutableSubtree error_repeat = ts_subtree_new_node(
     ts_builtin_sym_error_repeat,
     &children,
@@ -1409,6 +1428,7 @@ static void ts_parser__recover(
 
     ts_stack_renumber_version(self->stack, array_get(&pop, 0)->version, version);
     array_push(&array_get(&pop, 0)->subtrees, ts_subtree_from_mut(error_repeat));
+    ts_parser__count_summarized(self, array_get(&pop, 0)->subtrees.size);
     error_repeat = ts_subtree_new_node(
       ts_builtin_sym_error_repeat,
       &array_get(&pop, 0)->subtrees,
@@ -1542,6 +1562,8 @@ static bool ts_parser__check_progress(TSParser *self, Subtree *lookahead, const
     self->parse_state.current_byte_offset = *position;
     self->parse_state.has_error = self->has_error;
   }
+  self->parse_state.lexed_char_count = self->lexer.advance_count;
+  self->parse_state.summarized_child_count = self->summarized_child_count;
   if (
     self->operation_count == 0 &&
     (self->parse_options.progress_callback && self->parse_options.progress_callback(&self->parse_state))
@@ -2069,6 +2091,8 @@ void ts_parser_reset(TSParser *self) {
   self->canceled_balancing = false;
   self->parse_options = (TSParseOptions) {0};
   self->parse_state = (TSParseState) {0};
+  self->lexer.advance_count = 0;
+  self->summarized_child_count = 0;
 }
 
