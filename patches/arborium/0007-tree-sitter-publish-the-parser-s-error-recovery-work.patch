+    pub reduction_scan_count: u32,
+    pub popped_subtree_count: u32,
+    pub lexed_char_count: u32,
+    pub summarized_child_count: u32,
 }
 #[repr(C)]
 #[derive(Debug, Copy, Clone)]
diff --git a/crates/arborium-tree-sitter/binding_rust/lib.rs b/crates/arborium-tree-sitter/binding_rust/lib.rs
index 4665137..7f0e539 100644
--- a/crates/arborium-tree-sitter/binding_rust/lib.rs
+++ b/crates/arborium-tree-sitter/binding_rust/lib.rs
@@ -193,6 +193,51 @@ impl ParseState {
     pub const fn has_error(&self) -> bool {
         unsafe { self.0.as_ref() }.has_error
     }
+
+    /// Parse-table entries looked up so far in this parse while searching
+    /// for every reduction possible in a state — work the operation count
+    /// behind the progress callback doesn't see. Grows mainly during error
+    /// recovery. Callers metering parse work, rather than wall-clock time,
+    /// should weight by it.
+    #[must_use]
+    pub const fn reduction_scan_count(&self) -> u32 {
+        unsafe { self.0.as_ref() }.reduction_scan_count
+    }
+
+    /// Subtrees popped off the stack by reductions so far in this parse,
+    /// summed over every stack path a reduction follows — work the
+    /// operation count behind the progress callback doesn't see. Grows
+    /// quickly when error recovery leaves many paths through the stack.
+    /// Callers metering parse work, rather than wall-clock time, should
+    /// weight by it.
+    #[must_use]
+    pub const fn popped_subtree_count(&self) -> u32 {
+        unsafe { self.0.as_ref() }.popped_subtree_count
+    }
+
+    /// Characters the lexer has advanced over so far in this parse, counting
+    /// every `advance` call from the generated lexer and from external
+    /// scanners — work the operation count behind the progress callback
+    /// doesn't see, since one operation lexes one token however long it is.
+    /// Error recovery re-lexes text, so this can exceed the input length.
+    /// Saturates at `u32::MAX`. Callers metering parse work, rather than
+    /// wall-clock time, should weight by it.
+    #[must_use]
+    pub const fn lexed_char_count(&self) -> u32 {
+        unsafe { self.0.as_ref() }.lexed_char_count
+    }
+
+    /// Children of the nodes the parser has built so far in this parse,
+    /// each of which the node constructor walks to summarize — work the
+    /// operation count behind the progress callback doesn't see. Error
+    /// recovery that keeps growing one ERROR node rebuilds it from all its
+    /// children for every token it skips, so this grows quadratically there.
+    /// Saturates at `u32::MAX`. Callers metering parse work, rather than
+    /// wall-clock time, should weight by it.
+    #[must_use]
+    pub const fn summarized_child_count(&self) -> u32 {
+        unsafe { self.0.as_ref() }.summarized_child_count
+    }
 }
 
 /// A stateful object that is passed into a [`QueryProgressCallback`]
diff --git a/crates/arborium-tree-sitter/include/tree_sitter/api.h b/crates/arborium-tree-sitter/include/tree_sitter/api.h
index af2601d..33ebc00 100644
--- a/crates/arborium-tree-sitter/include/tree_sitter/api.h
+++ b/crates/arborium-tree-sitter/include/tree_sitter/api.h
@@ -97,6 +97,35 @@ typedef struct TSParseState {
   void *payload;
   uint32_t current_byte_offset;
   bool has_error;
+  /**
+   * Work the parser has done so far in this parse that the operation count
+   * behind the progress callback doesn't see. Both grow mainly during error
+   * recovery, where one operation can cost many times an ordinary one, so a
+   * caller metering parse work (rather than elapsed time) should weight by
+   * them.
+   *
+   * - `reduction_scan_count`: parse-table entries looked up while searching
+   *   for every reduction possible in a state (each lookup scans a table
+   *   row).
+   * - `popped_subtree_count`: subtrees popped off the stack by reductions,
+   *   summed over every stack path a reduction follows.
+   * - `lexed_char_count`: characters the lexer advanced over, counting
+   *   every `advance` call from the generated lexer and from external
+   *   scanners. One operation lexes one token, however long it is, and
+   *   error recovery re-lexes the same text, so this is not bounded by the
+   *   input length. Updated each time the progress callback is consulted.
+   *   Saturates at UINT32_MAX.
+   * - `summarized_child_count`: children of the nodes the parser has built,
+   *   each of which the node constructor walks to summarize. Error recovery
+   *   that keeps growing one ERROR node rebuilds it from all its children
+   *   for every token it skips, which is quadratic in the tokens skipped.
+   *   Updated each time the progress callback is consulted. Saturates at
+   *   UINT32_MAX.
+   */
+  uint32_t reduction_scan_count;
+  uint32_t popped_subtree_count;
+  uint32_t lexed_char_count;
+  uint32_t summarized_child_count;
 } TSParseState;
 
 typedef struct TSParseOptions {
