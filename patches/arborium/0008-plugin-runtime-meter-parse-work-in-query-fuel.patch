 ///
 /// Sized so that legitimate source files finish comfortably while the
 /// quadratic-query blowup below is cut off — see
-/// `arborium_rt::highlight::HIGHLIGHT_FUEL`, which uses the same figure for
-/// a whole document. Callers running a multi-grammar pipeline (a primary
+/// `arborium_rt::highlight::HIGHLIGHT_FUEL`, the pool for a whole document's
+/// parses and queries. Callers running a multi-grammar pipeline (a primary
 /// parse plus injections) should allot one shared pool across the document
 /// via [`PluginRuntime::parse_with_fuel`] rather than taking this default
 /// per call, so total cost is bounded no matter how many injected blocks
 /// the document contains.
 pub const DEFAULT_QUERY_FUEL: u32 = 80_000_000;
 
-/// Parser operations [`PluginRuntime::set_text`] may spend per byte of input
-/// before the parse is abandoned. Query fuel only meters queries, so without
-/// this the parse itself has no upper bound.
+/// Parser operations that run between two ticks of the parse progress
+/// callback.
 ///
-/// Scaling with input length keeps large ordinary documents whole while still
-/// cutting off parses that grow faster than the input. Measured costs: typical
-/// source is ~0.5–1.3 operations per byte and dense method chains ~7, while
-/// superlinear parses pass 10 within a few hundred bytes and keep climbing.
-pub const PARSE_OPERATIONS_PER_BYTE: u64 = 10;
+/// tree-sitter consults the callback once every
+/// `OP_COUNT_PER_PARSER_CALLBACK_CHECK` (= 100) parser operations
+/// (`parser.c`), so that is the granularity at which a parse can be metered
+/// and stopped.
+pub const PARSE_OPS_PER_TICK: u32 = 100;
 
-/// Lower bound on the parse budget, so very short inputs aren't held to a
-/// handful of operations.
-pub const MIN_PARSE_OPERATIONS: u64 = 10_000;
+/// Fuel charged for one parser operation.
+///
+/// Parsing is metered in the same fuel as queries, so one allotment can
+/// cover both — see [`parse_fuel_cost`]. The five `PARSE_FUEL_PER_*`
+/// constants are a cost model of tree-sitter's parser: operations (the
+/// steps the progress callback counts) plus the kinds of work an operation
+/// can hide. One operation on ordinary source costs about the same as any
+/// other, but while recovering, one operation can search every reduction
+/// possible in a state (`PARSE_FUEL_PER_REDUCTION_SCAN`) and pop subtrees
+/// along many paths through the stack (`PARSE_FUEL_PER_POPPED_SUBTREE`),
+/// costing 5–10× as much. Charging operations alone would let an input that
+/// keeps the parser recovering run for ~8× longer per unit of fuel than
+/// ordinary source does. Recovery can also keep growing one ERROR node,
+/// rebuilding it from all of its children for every token it skips, which
+/// is quadratic while the operation count stays linear
+/// (`PARSE_FUEL_PER_SUMMARIZED_CHILD`). And one operation lexes one token,
+/// however long it is, while error recovery re-lexes text, so characters
+/// lexed are charged separately (`PARSE_FUEL_PER_LEXED_CHAR`).
+///
+/// The constants were fitted by timing parses in the browser runtime and
+/// are in query-fuel units, i.e. scaled so that a unit of fuel costs about
+/// the same time whether a parse or a query spends it. Under the fit,
+/// milliseconds-per-fuel stays within ~2× across ordinary source, broken
+/// and wrong-language source, long tokens and comments, and the superlinear
+/// recovery inputs this guards against.
+pub const PARSE_FUEL_PER_OPERATION: u32 = 16;
+
+/// Fuel charged per parse-table entry the parser looks up while searching
+/// for every reduction possible in a state. See
+/// [`PARSE_FUEL_PER_OPERATION`].
+pub const PARSE_FUEL_PER_REDUCTION_SCAN: u32 = 15;
+
+/// Fuel charged per subtree a reduction pops off the parse stack, summed
+/// over every stack path it follows. See [`PARSE_FUEL_PER_OPERATION`].
+pub const PARSE_FUEL_PER_POPPED_SUBTREE: u32 = 47;
+
+/// Fuel charged per character the lexer advances over, whether the
+/// generated lexer or an external scanner asked. See
+/// [`PARSE_FUEL_PER_OPERATION`].
+///
+/// The count is only read when the progress callback ticks, so the
+/// characters of a token lexed after the last tick, or of a document that
+/// parses in fewer than [`PARSE_OPS_PER_TICK`] operations, aren't charged.
+pub const PARSE_FUEL_PER_LEXED_CHAR: u32 = 10;
+
+/// Fuel charged per child of each node the parser builds, every one of
+/// which the node constructor walks to summarize. See
+/// [`PARSE_FUEL_PER_OPERATION`].
+///
+/// This is the term that catches error recovery growing one ERROR node:
+/// it rebuilds the node from all of its children for every token it skips,
+/// which is quadratic in the tokens skipped while the operation count stays
+/// linear.
+pub const PARSE_FUEL_PER_SUMMARIZED_CHILD: u32 = 2;
+
+/// Fuel allotted to a bare [`PluginRuntime::set_text`], i.e. one parse with
+/// no caller-supplied budget. The same figure as [`DEFAULT_QUERY_FUEL`]:
+/// both are measured in the same fuel.
+///
+/// Callers parsing and querying one document across several grammars (a
+/// primary parse plus injections) should thread one pool through every
+/// parse and query via [`PluginRuntime::set_text_with_fuel`] and
+/// [`PluginRuntime::parse_with_fuel`] instead, so the document as a whole
+/// is bounded.
+pub const DEFAULT_PARSE_FUEL: u32 = 80_000_000;
+
+/// Fuel a parse has cost after `ticks` progress-callback ticks, given the
+/// parser's cumulative work counters for the parse. Saturates at `u32::MAX`.
+///
+/// See [`PARSE_FUEL_PER_OPERATION`] for the cost model.
+#[must_use]
+pub fn parse_fuel_cost(
+    ticks: u32,
+    reduction_scans: u32,
+    popped_subtrees: u32,
+    lexed_chars: u32,
+    summarized_children: u32,
+) -> u32 {
+    let operations = u64::from(ticks) * u64::from(PARSE_OPS_PER_TICK);
+    let fuel = operations * u64::from(PARSE_FUEL_PER_OPERATION)
+        + u64::from(reduction_scans) * u64::from(PARSE_FUEL_PER_REDUCTION_SCAN)
+        + u64::from(popped_subtrees) * u64::from(PARSE_FUEL_PER_POPPED_SUBTREE)
+        + u64::from(lexed_chars) * u64::from(PARSE_FUEL_PER_LEXED_CHAR)
+        + u64::from(summarized_children) * u64::from(PARSE_FUEL_PER_SUMMARIZED_CHILD);
+    u32::try_from(fuel).unwrap_or(u32::MAX)
+}
 
