 crates/arborium-wire/src/lib.rs           |   8 +-
 2 files changed, 210 insertions(+), 53 deletions(-)

diff --git a/crates/arborium-plugin-runtime/src/lib.rs b/crates/arborium-plugin-runtime/src/lib.rs
index b67283f..be1bc08 100644
--- a/crates/arborium-plugin-runtime/src/lib.rs
+++ b/crates/arborium-plugin-runtime/src/lib.rs
@@ -195,6 +195,10 @@ struct Session {
     text: String,
     cursor: QueryCursor,
     cancelled: AtomicBool,
+    /// What the last parse of `text` cost. When it ran out of fuel, `tree`
+    /// is `None` and queries report the session as out of fuel rather than
+    /// failing.
+    parse_fuel: FuelSpent,
 }
 
 impl Session {
@@ -209,8 +213,57 @@ impl Session {
             text: String::new(),
             cursor: QueryCursor::new(),
             cancelled: AtomicBool::new(false),
+            parse_fuel: NO_FUEL_SPENT,
         }
     }
+
+    /// Parse `self.text` — incrementally against the current tree, when
+    /// `incremental` is set and there is one — spending at most `fuel`, and
+    /// record the cost in `parse_fuel`.
+    ///
+    /// On every tick the progress callback re-prices the parse so far with
+    /// [`parse_fuel_cost`] and halts the parser once the allotment is spent.
+    /// A halted parse leaves the session with no tree. Work after the last
+    /// tick (at most [`PARSE_OPS_PER_TICK`] operations) isn't charged.
+    fn reparse(&mut self, incremental: bool, fuel: u32) -> FuelSpent {
+        let old_tree = self.tree.take().filter(|_| incremental);
+        let spent = Cell::new(0u32);
+        let mut ticks = 0u32;
+        let mut burn_fuel = |state: &ParseState| -> ControlFlow<()> {
+            // The parser's work counters are cumulative for the parse, so
+            // price the whole parse afresh rather than adding up deltas.
+            ticks = ticks.saturating_add(1);
+            let used = parse_fuel_cost(
+                ticks,
+                state.reduction_scan_count(),
+                state.popped_subtree_count(),
+                state.lexed_char_count(),
+                state.summarized_child_count(),
+            );
+            spent.set(used);
+            if used >= fuel {
+                ControlFlow::Break(())
+            } else {
+                ControlFlow::Continue(())
+            }
+        };
+        let source = self.text.as_bytes();
+        self.tree = self.parser.parse_with_options(
+            &mut |i, _| source.get(i..).unwrap_or_default(),
+            old_tree.as_ref(),
+            Some(ParseOptions::new().progress_callback(&mut burn_fuel)),
+        );
+        let out_of_fuel = self.tree.is_none();
+        if out_of_fuel {
+            // Otherwise tree-sitter resumes the abandoned parse on the next call.
+            self.parser.reset();
+        }
+        self.parse_fuel = FuelSpent {
+            used: spent.get(),
+            out_of_fuel,
+        };
+        self.parse_fuel
+    }
 }
 
