// Cloudflare Worker that serves the playground. Static assets only: there is
// no `main` script, so the Worker just serves `dist/` (the `bundle` output).
//
// CI deploys it from .github/workflows/build.yml (`deploy-site`): pushes to
// main run `wrangler deploy`, and same-repo PRs run `wrangler preview --name
// pr-<n>`. .github/workflows/site-cleanup.yml deletes the preview when the PR
// closes. Those jobs check out this file from the commit being built and
// download `dist/` from the `site` job's artifact.
{
	"name": "arborium-rt-playground",
	"compatibility_date": "2026-11-01",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./dist"
	}
}
